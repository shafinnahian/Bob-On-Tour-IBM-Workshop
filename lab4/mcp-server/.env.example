# MCP Server Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================

# Database connection details
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=mcp_lab
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# SSL Configuration (set to true for production)
DATABASE_SSL=false

# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================
# IBM Code Engine Configuration (Production)
# ============================================
# Uncomment and update these when deploying to Code Engine

# DATABASE_HOST=postgres-mcp
# DATABASE_PORT=5432
# DATABASE_NAME=mcp_lab
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your-secure-password
# DATABASE_SSL=true

# ============================================
# IBM Cloud Databases for PostgreSQL
# ============================================
# Use this format when connecting to IBM Cloud Databases

# DATABASE_HOST=your-instance.databases.appdomain.cloud
# DATABASE_PORT=30123
# DATABASE_NAME=ibmclouddb
# DATABASE_USER=ibm_cloud_user
# DATABASE_PASSWORD=your-secure-password
# DATABASE_SSL=true

# ============================================
# Server Configuration
# ============================================

# Logging level (error, warn, info, debug)
LOG_LEVEL=info

# Server port (if running as HTTP server)
PORT=3000

# ============================================
# Security Configuration
# ============================================

# API authentication (if needed)
# API_KEY=your-api-key-here

# Rate limiting
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# ============================================
# Development vs Production
# ============================================

# Environment mode
NODE_ENV=development

# Enable debug mode
DEBUG=false